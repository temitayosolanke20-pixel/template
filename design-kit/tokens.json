{
  "_meta": {
    "source": "Structural extraction from affluent.co",
    "note": "Brand colors deliberately excluded. Only spacing and typography tokens are included. Values are in rem unless noted.",
    "baseUnit": "8px",
    "baseFontSize": "16px"
  },

  "spacing": {
    "scale": {
      "0":   "0px",
      "1":   "4px",
      "2":   "8px",
      "3":   "12px",
      "4":   "16px",
      "5":   "20px",
      "6":   "24px",
      "7":   "28px",
      "8":   "32px",
      "10":  "40px",
      "12":  "48px",
      "14":  "56px",
      "16":  "64px",
      "20":  "80px",
      "24":  "96px",
      "28":  "112px",
      "30":  "120px"
    },
    "section": {
      "hero":    { "paddingTop": "120px", "paddingBottom": "120px" },
      "standard":{ "paddingTop": "96px",  "paddingBottom": "96px"  },
      "compact": { "paddingTop": "64px",  "paddingBottom": "64px"  },
      "band":    { "paddingTop": "48px",  "paddingBottom": "48px"  },
      "footer":  { "paddingTop": "48px",  "paddingBottom": "32px"  }
    },
    "container": {
      "maxWidth":      "1200px",
      "gutterMobile":  "24px",
      "gutterDesktop": "48px"
    },
    "grid": {
      "featureCards":   { "columnGap": "32px", "rowGap": "32px" },
      "stats":          { "gap": "24px" },
      "logoStrip":      { "gap": "40px" },
      "splitLayout":    { "gap": "80px" },
      "cardPadding":    "32px"
    },
    "component": {
      "buttonPaddingVertical":   "14px",
      "buttonPaddingHorizontal": "28px",
      "headlineToLede":          "20px",
      "ledeToAction":            "32px",
      "cardInternalPadding":     "32px",
      "navHeight":               "72px"
    }
  },

  "typography": {
    "fontFamily": {
      "sans": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica Neue, Arial, sans-serif"
    },
    "fontWeight": {
      "regular":     400,
      "medium":      500,
      "semibold":    600,
      "bold":        700,
      "extrabold":   800
    },
    "scale": {
      "display": {
        "fontSize":      "56px",
        "fontSizeRem":   "3.5rem",
        "lineHeight":    1.1,
        "letterSpacing": "-0.03em",
        "fontWeight":    800,
        "mobileSize":    "36px"
      },
      "h2": {
        "fontSize":      "40px",
        "fontSizeRem":   "2.5rem",
        "lineHeight":    1.15,
        "letterSpacing": "-0.02em",
        "fontWeight":    700,
        "mobileSize":    "28px"
      },
      "h3": {
        "fontSize":      "24px",
        "fontSizeRem":   "1.5rem",
        "lineHeight":    1.3,
        "letterSpacing": "-0.01em",
        "fontWeight":    600,
        "mobileSize":    "20px"
      },
      "h4": {
        "fontSize":      "16px",
        "fontSizeRem":   "1rem",
        "lineHeight":    1.4,
        "letterSpacing": "0.04em",
        "fontWeight":    600,
        "textTransform": "uppercase",
        "mobileSize":    "14px"
      },
      "body": {
        "fontSize":      "18px",
        "fontSizeRem":   "1.125rem",
        "lineHeight":    1.7,
        "letterSpacing": "0",
        "fontWeight":    400
      },
      "small": {
        "fontSize":      "14px",
        "fontSizeRem":   "0.875rem",
        "lineHeight":    1.5,
        "letterSpacing": "0",
        "fontWeight":    400
      },
      "button": {
        "fontSize":      "16px",
        "fontSizeRem":   "1rem",
        "lineHeight":    1,
        "letterSpacing": "0",
        "fontWeight":    600
      },
      "stat": {
        "fontSize":      "56px",
        "fontSizeRem":   "3.5rem",
        "lineHeight":    1.0,
        "letterSpacing": "-0.02em",
        "fontWeight":    800
      },
      "statLabel": {
        "fontSize":      "14px",
        "fontSizeRem":   "0.875rem",
        "lineHeight":    1.5,
        "letterSpacing": "0.04em",
        "fontWeight":    500,
        "textTransform": "uppercase"
      }
    }
  },

  "neutralColors": {
    "_note": "Neutral scaffold palette only — no brand colors",
    "white":     "#FFFFFF",
    "gray50":    "#F9FAFB",
    "gray100":   "#F3F4F6",
    "gray200":   "#E5E7EB",
    "gray300":   "#D1D5DB",
    "gray400":   "#9CA3AF",
    "gray500":   "#6B7280",
    "gray600":   "#4B5563",
    "gray700":   "#374151",
    "gray800":   "#1F2937",
    "gray900":   "#111827",
    "black":     "#000000"
  },

  "shadows": {
    "card":   "0 4px 16px rgba(0,0,0,0.08)",
    "raised": "0 8px 32px rgba(0,0,0,0.12)"
  },

  "borderRadius": {
    "sm":  "4px",
    "md":  "8px",
    "lg":  "12px",
    "xl":  "16px",
    "pill":"9999px"
  }
}
